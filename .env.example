VITE_API_URL=http://127.0.0.1:8000/api
# Optional server-only key matching the backend's SSR_INTERNAL_API_KEY.
# Never prefix this secret with VITE_.
SSR_INTERNAL_API_KEY=

# Public Nepali site origin, matching NP_SITE_URL on the backend. No parent-site fallback.
# Set the final domain before building for launch. Unset builds remain noindex.
VITE_SITE_URL=

# Optional public verification token for a separate Search Console URL-prefix property.
VITE_GOOGLE_SITE_VERIFICATION=

# Optional locally; configured for production in netlify.toml.
VITE_GA_MEASUREMENT_ID=
